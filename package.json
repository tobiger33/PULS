{
  "name": "puls",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.24",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "parse5": "^8.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test research/score_engine.test.js tests/*.test.ts",
    "build:web": "expo export --platform web && node scripts/copy-static-assets.mjs",
    "build:ios": "expo export --platform ios --output-dir .expo/exports/ios",
    "build:android": "expo export --platform android --output-dir .expo/exports/android",
    "format": "prettier --write App.tsx index.ts \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/*.ts\" \"scripts/*.mjs\""
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
